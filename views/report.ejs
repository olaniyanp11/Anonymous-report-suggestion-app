<%- include("./partials/header") %>

<div class="flex min-h-screen pt-16">
  <!-- Sidebar -->
  <aside class="w-64 bg-gray-800 hidden md:block">
    <div class="p-6 text-2xl font-bold text-green-400">
      <i class="fas fa-user-shield mr-2"></i> Admin Panel
    </div>
    <nav class="px-6 space-y-2 text-white">
      <a href="/dashboard" class="block py-2 px-4 rounded hover:bg-gray-700">
        <i class="fas fa-tachometer-alt mr-2"></i> Dashboard
      </a>
      <a href="/admin/reports" class="block py-2 px-4 rounded hover:bg-gray-700">
        <i class="fas fa-exclamation-circle mr-2"></i> All Reports
      </a>
      <a href="/admin/suggestion" class="block py-2 px-4 rounded hover:bg-gray-700">
        <i class="fas fa-lightbulb mr-2"></i> All Suggestions
      </a>
      <a href="/logout" class="block py-2 px-4 rounded hover:bg-red-600 text-white">
        <i class="fas fa-sign-out-alt mr-2"></i> Logout
      </a>
    </nav>
  </aside>

  <div class="w-[70%] mx-auto">

    <!-- Small Reports Pie Chart -->
    <section class="mt-10 bg-gray-800 p-4 rounded-lg w-full max-w-md mx-auto">
      <h3 class="text-lg font-semibold mb-4 text-center text-white">Reports Status</h3>
      <canvas id="reportsPieChart" width="300" height="150"></canvas>
    </section>

    <!-- Recent Reports Section -->
    <section class="mt-10">
      <h3 class="text-xl font-semibold mb-4 text-white">Recent Reports</h3>
      <div class="bg-gray-800 p-4 rounded-lg">
        <ul class="space-y-3">
          <% recentReports.forEach((report) => { %>
            <li class="border-b border-gray-700 pb-2 flex items-start gap-3">
              <input
                type="checkbox"
                class="mt-1 checkbox-report accent-green-500 cursor-pointer"
                data-id="<%= report._id %>"
                data-type="report"
                title="Mark report as responded"
                <%= report.sorted ? 'checked' : '' %>
              />
              <div class="flex-1 cursor-pointer toggle-message" data-id="<%= report._id %>" data-type="report">
                <span class="text-green-300 font-semibold">#<%= report._id %></span> -
                <%= report.title %>
                <div class="text-gray-400 text-sm hidden mt-1" id="msg-report-<%= report._id %>">
                  <%= report.message %>
                </div>
                <div class="text-xs text-gray-500 mt-1">Submitted: <%= report.createdAt.toLocaleString() %></div>
              </div>
            </li>
          <% }); %>
        </ul>
      </div>
    </section>

  </div>
</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
  // Toggle report message
  $('.toggle-message').click(function() {
    const type = $(this).data('type');
    const id = $(this).data('id');
    $(`#msg-${type}-${id}`).toggleClass('hidden');
  });

  // Handle checkbox change
  $('.checkbox-report').click(async function(e){
    e.stopPropagation();
    const id = $(this).data('id');
    const isChecked = $(this).prop('checked');
    const url = `/admin/reports/${id}/respond`;

    $(this).prop('disabled', true);
    try {
      const res = await fetch(url, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ responded: isChecked })
      });
      if (res.ok) {
        alert(`Marked report as ${isChecked ? 'responded' : 'not responded'}`);
      } else {
        alert(`Failed to update report`);
      }
    } catch (err) {
      console.error(err);
      alert(`Error updating report`);
    } finally {
      $(this).prop('disabled', false);
    }
  });

  // Pie Chart - Reports Only
  const reportsCtx = document.getElementById('reportsPieChart').getContext('2d');
  const reportsPieChart = new Chart(reportsCtx, {
    type: 'pie',
    data: {
      labels: ['Responded', 'Pending'],
      datasets: [{
        data: [<%= respondedReports %>, <%= pendingReports %>],
        backgroundColor: ['rgba(34,197,94,0.7)', 'rgba(234,179,8,0.7)'],
        borderColor: ['rgba(34,197,94,1)', 'rgba(234,179,8,1)'],
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      plugins: { 
        legend: { position: 'bottom' },
        title: { display: true, text: 'Reports Status' }
      }
    }
  });
</script>

<%- include('../partials/footer') %>
